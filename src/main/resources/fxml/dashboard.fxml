<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hospital.gui.controller.DashboardController"
            stylesheets="@../css/style.css">

    <top>
        <ToolBar styleClass="toolbar">
            <Label text="Hospital Dashboard" styleClass="toolbar-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="userLabel" styleClass="user-label" />
            <Button text="Logout" onAction="#onLogout" styleClass="logout-button" />
        </ToolBar>
    </top>

    <left>
        <VBox spacing="5" padding="10" styleClass="sidebar">
            <Label text="Navigation" styleClass="sidebar-title" />
            <Button text="Patients" onAction="#openPatients" styleClass="nav-button" prefWidth="150" />
            <Button text="Appointments" onAction="#openAppointments" styleClass="nav-button" prefWidth="150" />
            <Button text="Billing" onAction="#openBilling" styleClass="nav-button" prefWidth="150" />
            <Button text="Medical Records" onAction="#openMedicalRecords" styleClass="nav-button" prefWidth="150" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane">
            <VBox alignment="CENTER" spacing="20">
                <Label text="Welcome to Hospital Management System" styleClass="welcome-title" />
                <Label text="Select an option from the menu to get started" styleClass="welcome-subtitle" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
